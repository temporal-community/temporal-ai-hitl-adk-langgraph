# Gemini — restricted to Gemini API
GOOGLE_API_KEY=your-gemini-api-key-here

# Maps — restricted to Directions API
GOOGLE_MAPS_API_KEY=your-maps-api-key-here

# Optional: the Gemini model for every agent call. The default, gemini-3.8-flash, is what
# Google recommends for new projects; gemini-2.5-flash only works for keys that used it before.
# Use a paid-tier key: the Customer agent is told to search Google for venue events on each
# order, and 3.8 Flash has no free-tier Grounding with Google Search. Paid tier: 5,000 search
# queries/month free across 3.x, then $14 per 1,000 (billed per query the model runs).
# Tokens: $0.75 input / $3.75 output (thinking included) per 1M tokens until 2026-12-31,
# then $1.50 / $7.50 (ai.google.dev/gemini-api/docs/pricing, checked 2026-09-29).
# DEFAULT_MODEL=gemini-3.8-flash

# Optional: seconds an unanswered ask_human waits before escalating to a backup approver.
# GATE_ESCALATION_SECONDS=30
